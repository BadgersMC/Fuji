+/**
+ * The redstone implementation to use.
+ */
+@NullMarked
+public enum RedstoneImplementation {
+    VANILLA("vanilla"),
+    EIGENCRAFT("eigencraft"),
+    ALTERNATE_CURRENT("alternate-current");
