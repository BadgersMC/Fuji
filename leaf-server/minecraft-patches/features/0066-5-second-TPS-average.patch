diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index b321c3d3fb10d07702feab7635db55e3f7bb1bd7..ec8e1210a42f207abf95ff76c623db8da3a3e01f 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -366,6 +366,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     private final java.util.concurrent.atomic.AtomicInteger tickTaskTickCount = new java.util.concurrent.atomic.AtomicInteger();
     private final Object statsLock = new Object();
     private double @Nullable [] tps;
+    private double @Nullable [] tps5s; // Gale - 5-second TPS average
     private ca.spottedleaf.common.time.TickData.@Nullable MSPTData msptData5s;
 
     private void addTickTime(final ca.spottedleaf.common.time.TickTime time) {
@@ -384,6 +385,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     private void clearTickTimeStatistics() {
         this.msptData5s = null;
         this.tps = null;
+        this.tps5s = null;
     }
 
     private static double getTPS(final ca.spottedleaf.common.time.TickData tickData, final long tickInterval) {
@@ -423,6 +425,34 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             getTPS(this.tickTimes15m, interval)
         };
     }
+    // Gale - 5-second TPS average for lag thresholds and diagnostic commands.
+    public double[] getTPSIncluding5Seconds() {
+        synchronized (this.statsLock) {
+            if (this.tps5s == null) {
+                this.tps5s = this.computeTPSIncluding5Seconds();
+            }
+            return this.tps5s.clone();
+        }
+    }
+
+    public double[] getTPSIncluding5SecondsReadOnly() {
+        synchronized (this.statsLock) {
+            if (this.tps5s == null) {
+                this.tps5s = this.computeTPSIncluding5Seconds();
+            }
+            return this.tps5s;
+        }
+    }
+
+    public double[] computeTPSIncluding5Seconds() {
+        final long interval = this.tickRateManager().nanosecondsPerTick();
+        return new double[] {
+            getTPS(this.tickTimes5s, interval),
+            getTPS(this.tickTimes1m, interval),
+            getTPS(this.tickTimes5m, interval),
+            getTPS(this.tickTimes15m, interval)
+        };
+    }
     // Paper end - improve tick loop
 
     public MinecraftServer(
@@ -1211,7 +1241,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                         io.papermc.paper.configuration.GlobalConfiguration.get().misc.catchupTicks.or(5)
                     );
 
-                    lagging = getTPS()[0] < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold
+                    lagging = getTPSIncluding5SecondsReadOnly()[0] < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold
 
                     // adjust ticksBehind so that it is not greater-than catchup
                     if (ticksBehind - catchup > 0L) {
diff --git a/net/minecraft/server/gui/StatsComponent.java b/net/minecraft/server/gui/StatsComponent.java
