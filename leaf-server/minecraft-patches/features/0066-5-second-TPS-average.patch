@@ -33,7 +33,7 @@ public class StatsComponent extends JComponent {
     private void tick() {
         long usedRam = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
         // Paper start - Improve ServerGUI
