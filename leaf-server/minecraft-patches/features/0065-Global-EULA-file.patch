diff --git a/net/minecraft/server/Eula.java b/net/minecraft/server/Eula.java
index 62ef2b25fdb0657bd468401f986639085908b13d..70b56a6bfe13407e473acabcdbe1e1e9146bf0a1 100644
--- a/net/minecraft/server/Eula.java
+++ b/net/minecraft/server/Eula.java
@@ -17,17 +17,32 @@ public class Eula {
 
     public Eula(final Path file) {
         this.file = file;
-        this.agreed = DevUtil.IS_RUNNING_IN_IDE || this.readFile();
+        this.agreed = DevUtil.IS_RUNNING_IN_IDE || this.readGlobalFile() || this.readFile(); // Gale - global EULA support
     }
 
     private boolean readFile() {
-        try (InputStream input = Files.newInputStream(this.file)) {
+        return this.readFile(this.file);
+    }
+
+    private boolean readGlobalFile() {
+        try {
+            final Path globalFile = Path.of(System.getProperty("user.home"), "eula.txt");
+            return Files.isRegularFile(globalFile) && this.readFile(globalFile);
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
+
+    private boolean readFile(final Path file) {
+        try (InputStream input = Files.newInputStream(file)) {
             Properties properties = new Properties();
             properties.load(input);
             return Boolean.parseBoolean(properties.getProperty("eula", "false"));
         } catch (Exception ignored) {
-            LOGGER.warn("Failed to load {}", this.file);
-            this.saveDefaults();
+            if (file.equals(this.file)) {
+                LOGGER.warn("Failed to load {}", this.file);
+                this.saveDefaults();
+            }
             return false;
         }
     }
