From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Fri, 13 Nov 2026 07:16:37 -0500
Subject: [PATCH] Remove lambda from ticking guard

License: GPL-3.0-only. Gale/Airplane (Paul Sauve). Ported to 26.4 without obsolete Moonrise mid-tick hook, retaining Paper entity crash reporting and discard semantics.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 659374538b3cb3031d9a21509f97d39cde8204f7..a433f627739171fac04da433d603ed08399fafd0 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -670,7 +670,19 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                                     }
 
                                     profiler.push("tick");
-                                    this.guardEntityTick(this::tickNonPassenger, entity);
+                                    // Gale / Airplane - avoid a method-reference allocation on the hot entity-tick path.
+                                    try {
+                                        this.tickNonPassenger(entity);
+                                    } catch (Throwable error) {
+                                        // Keep Paper's original entity-crash reporting and discard behavior.
+                                        final String message = String.format("Entity threw exception at %s:%s,%s,%s",
+                                            io.papermc.paper.util.MCUtil.getLevelName(entity.level()), entity.getX(), entity.getY(), entity.getZ());
+                                        MinecraftServer.LOGGER.error(message, error);
+                                        this.getCraftServer().getPluginManager().callEvent(
+                                            new com.destroystokyo.paper.event.server.ServerExceptionEvent(
+                                                new com.destroystokyo.paper.exception.ServerInternalException(message, error)));
+                                        entity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DISCARD);
+                                    }
                                     profiler.pop();
                                 }
                             }
