Subject: [PATCH] Leaf config

Port Leaf config v3 startup hooks to Frontier Paper 26.4 Snapshot 8 bootstrap order.

diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index db42ba4283261f788888746a588724cff238bf5e..b8536da884ecf5b8d32247dbb11523654bfaecce 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -103,6 +103,8 @@ public class Main {
                 writePidFile(pidFilePath);
             }
 
+            org.dreeam.leaf.config.LeafConfig.loadConfig(); // Leaf - load config before bootstrap
+
             CrashReport.preload();
             if (options.has("jfrProfile")) { // CraftBukkit
                 JvmProfiler.INSTANCE.start(Environment.SERVER);
@@ -118,6 +120,7 @@ public class Main {
             io.papermc.paper.plugin.PluginInitializerManager.load(options); // Paper
             Bootstrap.bootStrap();
             Bootstrap.validate();
+            org.dreeam.leaf.config.ConfigModule.loadAfterBootstrap(); // Leaf - post-bootstrap config initialization
             Util.startTimerHackThread();
             Path settingsFile = Paths.get("server.properties");
             DedicatedServerSettings settings = new DedicatedServerSettings(options); // CraftBukkit - CLI argument support
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index c86fa92aa70c23211f30a8181e3b2c3b1a9e1fef..340dee2594f96866e6b39994d2a137d52f57d1f5 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1169,6 +1169,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             org.spigotmc.WatchdogThread.tick();
             // Paper end
             org.spigotmc.WatchdogThread.hasStarted = true; // Paper
+            org.dreeam.leaf.config.LeafConfig.regSparkExtraConfig(); // Leaf - Leaf config
             // Paper start - Add onboarding message for initial server start
             if (io.papermc.paper.configuration.GlobalConfiguration.isFirstStart) {
                 LOGGER.info("*************************************************************************************");
