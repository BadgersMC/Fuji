From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BadgersMC <blrusso18@gmail.com>
Date: Thu, 18 Jun 2026 21:53:25 -0400
Subject: [PATCH] Fuji: roof-cannon height nerf (require horizontal movement,
 opt-in)


diff --git a/net/minecraft/world/entity/item/FallingBlockEntity.java b/net/minecraft/world/entity/item/FallingBlockEntity.java
index a238a5c866d90c3c0da12a45edb1f07edac9364e..6a904230c6d429eb3f76224aa126947c4893ff4c 100644
--- a/net/minecraft/world/entity/item/FallingBlockEntity.java
+++ b/net/minecraft/world/entity/item/FallingBlockEntity.java
@@ -279,8 +279,10 @@ public class FallingBlockEntity extends Entity implements me.samsuik.sakura.enti
             this.limitLeftShooting(); // Sakura - configurable left shooting and adjusting limits
             this.move(MoverType.SELF, this.getDeltaMovement());
             this.applyEffectsFromBlocks();
-            // Paper start - Configurable falling blocks height nerf
-            if (this.level().paperConfig().fixes.fallingBlockHeightNerf.test(v -> this.getY() > v)) {
+            // Paper start - Configurable falling blocks height nerf // Fuji - roof-cannon nerf: optionally require horizontal movement (spec from Tequila, clean-room)
+            if (this.level().paperConfig().fixes.fallingBlockHeightNerf.test(v -> this.getY() > v
+                && (!org.dreeam.leaf.config.modules.gameplay.CannonHeightNerf.fallingBlockOnlyWithHorizontalMovement
+                    || this.getDeltaMovement().x != 0.0 || this.getDeltaMovement().z != 0.0))) {
                 if (this.dropItem && this.level() instanceof final ServerLevel serverLevel && serverLevel.getGameRules().get(GameRules.ENTITY_DROPS)) {
                     this.spawnAtLocation(serverLevel, block);
                 }
diff --git a/net/minecraft/world/entity/item/PrimedTnt.java b/net/minecraft/world/entity/item/PrimedTnt.java
index 527d2222808f707d356ac0511c1ef3859e7de307..298d31d12ab86e2c1a5fb5f899576c5559c79ec0 100644
--- a/net/minecraft/world/entity/item/PrimedTnt.java
+++ b/net/minecraft/world/entity/item/PrimedTnt.java
@@ -181,8 +181,10 @@ public class PrimedTnt extends Entity implements TraceableEntity, me.samsuik.sak
         this.applyGravity();
         this.move(MoverType.SELF, this.getDeltaMovement());
         this.applyEffectsFromBlocks();
-        // Paper start - Configurable TNT height nerf
-        if (this.level().paperConfig().fixes.tntEntityHeightNerf.test(v -> this.getY() > v)) {
+        // Paper start - Configurable TNT height nerf // Fuji - roof-cannon nerf: optionally require horizontal movement (spec from Tequila, clean-room)
+        if (this.level().paperConfig().fixes.tntEntityHeightNerf.test(v -> this.getY() > v
+            && (!org.dreeam.leaf.config.modules.gameplay.CannonHeightNerf.tntOnlyWithHorizontalMovement
+                || this.getDeltaMovement().x != 0.0 || this.getDeltaMovement().z != 0.0))) {
             this.discard(EntityRemoveEvent.Cause.OUT_OF_WORLD);
             return;
         }
