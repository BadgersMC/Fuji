+    // Fuji start - legacy (1.8-style) friction/air knockback model (clean-room)
+    private void fuji$applyLegacyKnockback(double x, double z, @Nullable Entity attacker, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eventCause) {
+        if (!canKnockback(attacker, this)) return;
+        final var cfg = this.level().sakuraConfig().players.knockback.legacy;
+        final double resistance = this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE);
+        if (cfg.probabilisticResistance && this.random.nextDouble() < resistance) {
+            return; // 1.8-style: a chance to fully resist
+        }
+        final double strength = 1.0 - resistance;
+
+        while (x * x + z * z < 1.0E-4) {
+            x = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
+            z = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
+        }
+        final double power = Math.sqrt(x * x + z * z);
+        final Vec3 original = this.getDeltaMovement();
+        final boolean onGround = this.onGround();
+
+        final double hMod = cfg.horizontalModifier * (onGround ? 1.0 : cfg.horizontalAirModifier);
+        final double vMod = cfg.verticalModifier * (onGround ? 1.0 : cfg.verticalAirModifier);
+
+        double cx = original.x / cfg.frictionHorizontal - x / power * hMod;
+        double cy = original.y / cfg.frictionVertical + vMod;
+        double cz = original.z / cfg.frictionHorizontal - z / power * hMod;
+
+        cx *= strength; cy *= strength; cz *= strength;
+        if (attacker != null && attacker.isSprinting()) {
+            cx *= cfg.sprintingHorizontalModifier;
+            cy *= cfg.sprintingVerticalModifier;
+            cz *= cfg.sprintingHorizontalModifier;
+        }
+        if (!cfg.probabilisticResistance) {
+            cx *= strength; cy *= strength; cz *= strength;
+        }
+        if (cy > cfg.verticalMax) {
+            cy = cfg.verticalMax;
+        }
+
+        final Vec3 finalVelocity = new Vec3(cx, cy, cz);
+        final Vec3 diff = finalVelocity.subtract(original);
+        io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent(this.getBukkitEntity(), attacker, attacker, eventCause, strength, diff);
+        if (event.isCancelled()) {
+            return;
+        }
+        this.needsSync = true;
+        this.setDeltaMovement(original.add(event.getKnockback().getX(), event.getKnockback().getY(), event.getKnockback().getZ()));
+    }
+    // Fuji end - legacy knockback model
+
     // Leaf start - Configurable player knockback zombie
