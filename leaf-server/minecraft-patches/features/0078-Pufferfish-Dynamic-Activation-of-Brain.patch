diff --git a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
index bb037ea27688a06bb0d8141ef25d2543d34aba80..401d3dfcce0fdf1de839bb6d858e813c069fc183 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
@@ -36,7 +36,20 @@ public class VillagerPanicTrigger extends Behavior<Villager> {
 
     @Override
     protected void tick(final ServerLevel level, final Villager body, final long timestamp) {
-        if (timestamp % 100L == 0L) {
+        // Pufferfish - preserve vanilla's 100-tick schedule when DAB is disabled.
+        if (!org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.enabled) {
+            if (timestamp % 100L == 0L) {
+                body.spawnGolemIfNeeded(level, timestamp, 3);
+            }
+            return;
+        }
+
+        // A throttled brain might skip the exact modulo tick; compare absolute game time.
+        if (body.nextGolemPanic < 0L) {
+            body.nextGolemPanic = timestamp + 100L;
+        }
+        if (timestamp >= body.nextGolemPanic) {
+            body.nextGolemPanic = timestamp + 100L;
             body.spawnGolemIfNeeded(level, timestamp, 3);
         }
     }
