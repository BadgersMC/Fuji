From f7a17f69fb0057a9298c744f62e422cfa9e075db Mon Sep 17 00:00:00 2001
From: etil2jz <81570777+etil2jz@users.noreply.github.com>
Date: Tue, 2 Aug 2022 14:48:12 +0200
Subject: [PATCH] Mirai: Configurable chat message signatures

Original license: GPL-3.0-only
Original project: https://github.com/etil2jz/Mirai
Compatibility updates by Dreeam and BadgersMC for Frontier 26.4.

Frontier Paper 26.4: preserve the native six-field ServerStatus codec and advertise secure chat policy consistently when explicitly opted out. Keep chat signature verification truthful rather than falsely claiming unsigned messages are trusted. Signed-chat configuration remains ENABLED by default. Original Mirai GPL-3.0-only with Dreeam updates. Runtime client verification pending.
---
 .../protocol/game/ClientboundLoginPacket.java    |  2 +-
 .../protocol/game/ServerboundChatPacket.java     |  2 +-
 .../network/protocol/status/ServerStatus.java    |  2 +-
 .../server/dedicated/DedicatedServer.java        |  1 +
 .../network/ServerGamePacketListenerImpl.java    | 16 ++++++++++++++--
 net/minecraft/server/players/PlayerList.java     |  2 +-
 6 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/net/minecraft/network/protocol/game/ClientboundLoginPacket.java b/net/minecraft/network/protocol/game/ClientboundLoginPacket.java
index 924a58e..6ab3b3f 100644
--- a/net/minecraft/network/protocol/game/ClientboundLoginPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundLoginPacket.java
@@ -49,7 +49,7 @@ public record ClientboundLoginPacket(
         ByteBufCodecs.BOOL,
         ClientboundLoginPacket::onlineMode,
         ByteBufCodecs.BOOL,
-        ClientboundLoginPacket::enforcesSecureChat,
+        packet -> org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled && packet.enforcesSecureChat(), // Leaf - Mirai: don't advertise enforcement after explicit opt-out
         ClientboundLoginPacket::new
     );
 
diff --git a/net/minecraft/network/protocol/game/ServerboundChatPacket.java b/net/minecraft/network/protocol/game/ServerboundChatPacket.java
index b758f2d..e40c135 100644
--- a/net/minecraft/network/protocol/game/ServerboundChatPacket.java
+++ b/net/minecraft/network/protocol/game/ServerboundChatPacket.java
@@ -20,7 +20,7 @@ public record ServerboundChatPacket(String message, Instant timeStamp, long salt
         ByteBufCodecs.LONG,
         ServerboundChatPacket::salt,
         MessageSignature.STREAM_CODEC.apply(ByteBufCodecs::optional),
-        ServerboundChatPacket::signature,
+        packet -> org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled ? packet.signature() : Optional.empty(), // Leaf - Mirai - Configurable chat message signatures
         LastSeenMessages.Update.STREAM_CODEC,
         ServerboundChatPacket::lastSeenMessages,
         ServerboundChatPacket::new
diff --git a/net/minecraft/network/protocol/status/ServerStatus.java b/net/minecraft/network/protocol/status/ServerStatus.java
index fffb0a9..22212f0 100644
--- a/net/minecraft/network/protocol/status/ServerStatus.java
+++ b/net/minecraft/network/protocol/status/ServerStatus.java
@@ -28,7 +28,7 @@ public record ServerStatus(
                 ServerStatus.Players.CODEC.lenientOptionalFieldOf("players").forGetter(ServerStatus::players),
                 ServerStatus.Version.CODEC.lenientOptionalFieldOf("version").forGetter(ServerStatus::version),
                 ServerStatus.Favicon.CODEC.lenientOptionalFieldOf("favicon").forGetter(ServerStatus::favicon),
-                Codec.BOOL.lenientOptionalFieldOf("enforcesSecureChat", false).forGetter(ServerStatus::enforcesSecureChat),
+                Codec.BOOL.lenientOptionalFieldOf("enforcesSecureChat", false).forGetter(status -> org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled && status.enforcesSecureChat()), // Leaf - Mirai - accurately advertise operator-selected chat policy
                 Codec.STRING.lenientOptionalFieldOf("contact").forGetter(ServerStatus::contact)
             )
             .apply(i, ServerStatus::new)
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 1c0f6c3..e7b75dc 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -798,6 +798,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
 
     @Override
     public boolean enforceSecureProfile() {
+        if (!org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled) return false; // Leaf - Mirai - Configurable chat message signatures
         DedicatedServerProperties properties = this.getProperties();
         // Paper start - Add setting for proxy online mode status
         return properties.enforceSecureProfile
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 2ac7218..95f2c61 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -2857,10 +2857,22 @@ public class ServerGamePacketListenerImpl
 
     public void sendPlayerChatMessage(final PlayerChatMessage message, final ChatType.Bound chatType) {
         // CraftBukkit start - SPIGOT-7262: if hidden we have to send as disguised message. Query whether we should send at all (but changing this may not be expected).
-        if (!this.getCraftPlayer().canSeePlayer(message.link().sender())) {
-            this.sendDisguisedChatMessage(message.decoratedContent(), chatType);
+        // Leaf start - Mirai - Configurable chat message signatures
+        final boolean canSeeSender = this.getCraftPlayer().canSeePlayer(message.link().sender());
+        if (!canSeeSender || !org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled) {
+            final @Nullable Component content = message.filterMask().isEmpty()
+                ? message.decoratedContent()
+                : message.filterMask().applyWithFormatting(message.signedContent());
+            if (content != null) {
+                if (canSeeSender) {
+                    this.send(new ClientboundSystemChatPacket(chatType.decorate(content), false));
+                } else {
+                    this.sendDisguisedChatMessage(content, chatType);
+                }
+            }
             return;
         }
+        // Leaf end - Mirai - Configurable chat message signatures
         // CraftBukkit end
         // Paper start - Ensure that client receives chat packets in the same order that we add into the message signature cache
         synchronized (this.messageSignatureCache) {
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 8b6c085..8510753 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -1222,7 +1222,7 @@ public abstract class PlayerList {
     public void broadcastChatMessage(final PlayerChatMessage message, final Predicate<ServerPlayer> isFiltered, final @Nullable ServerPlayer senderPlayer, final ChatType.Bound chatType, final @Nullable Function<net.kyori.adventure.audience.Audience, Component> unsignedFunction) {
         // Paper end
         boolean trusted = this.verifyChatTrusted(message);
-        this.server.logChatMessage((unsignedFunction == null ? message.decoratedContent() : unsignedFunction.apply(this.server.console)), chatType, trusted || !org.galemc.gale.configuration.GaleGlobalConfiguration.get().logToConsole.chat.notSecureMarker ? null : "Not Secure"); // Paper // Gale - do not log Not Secure marker
+        this.server.logChatMessage((unsignedFunction == null ? message.decoratedContent() : unsignedFunction.apply(this.server.console)), chatType, trusted || !org.dreeam.leaf.config.modules.network.ChatMessageSignature.enabled || !org.galemc.gale.configuration.GaleGlobalConfiguration.get().logToConsole.chat.notSecureMarker ? null : "Not Secure"); // Paper // Gale - do not log Not Secure marker // Leaf - Mirai - Configurable chat message signatures
         OutgoingChatMessage tracked = OutgoingChatMessage.create(message);
         boolean wasFullyFiltered = false;
 
-- 
2.39.1.windows.1

