diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index f555615463b667ddb7b2439600574019ade7bd2e..dff11d909bcd662faaa27f7e7fc72cb500f53e5e 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -124,6 +124,10 @@ import net.minecraft.world.scores.PlayerTeam;
 import org.jspecify.annotations.Nullable;
 
 public abstract class Player extends Avatar implements ContainerUser {
+    public final java.util.concurrent.atomic.AtomicReference<dev.tr7zw.entityculling.CullTask> cullTask =
+        new java.util.concurrent.atomic.AtomicReference<>();
+    private net.minecraft.world.level.@org.jspecify.annotations.Nullable Level lastCullWorld;
+
     public static final int MAX_HEALTH = 20;
     public static final int SLEEP_DURATION = 100;
     public static final int WAKE_UP_DURATION = 10;
@@ -305,6 +309,41 @@ public abstract class Player extends Avatar implements ContainerUser {
         }
         // Purpur end - Burp delay
 
+        // Leaf start - Raytrace Entity Tracker
+        if (this instanceof net.minecraft.server.level.ServerPlayer) {
+            if (!org.dreeam.leaf.config.modules.misc.RaytraceTracker.enabled) {
+                dev.tr7zw.entityculling.CullTask existing = this.cullTask.get();
+                if (existing != null) {
+                    existing.signalStop();
+                    this.cullTask.set(null);
+                }
+            } else {
+                net.minecraft.world.level.Level currLevel = this.level();
+                dev.tr7zw.entityculling.CullTask current = this.cullTask.get();
+                boolean needsUpdate = current == null || this.lastCullWorld != currLevel;
+
+                if (needsUpdate) {
+                    if (current != null) {
+                        current.signalStop();
+                    }
+                    final com.logisticscraft.occlusionculling.OcclusionCullingInstance culling = new com.logisticscraft.occlusionculling.OcclusionCullingInstance(
+                        org.dreeam.leaf.config.modules.misc.RaytraceTracker.maxTraceDistance,
+                        new dev.tr7zw.entityculling.DefaultChunkDataProvider(currLevel)
+                    );
+                    dev.tr7zw.entityculling.CullTask newTask = new dev.tr7zw.entityculling.CullTask(
+                        culling,
+                        this,
+                        org.dreeam.leaf.config.modules.misc.RaytraceTracker.boundingBoxLimit,
+                        org.dreeam.leaf.config.modules.misc.RaytraceTracker.traceInterval
+                    );
+                    this.cullTask.set(newTask);
+                    this.lastCullWorld = currLevel;
+                    newTask.setup();
+                }
+            }
+        }
+        // Leaf end - Raytrace Entity Tracker
+
         this.noPhysics = this.isSpectator();
         if (this.isSpectator() || this.isPassenger()) {
             this.setOnGround(false);
@@ -1516,6 +1555,10 @@ public abstract class Player extends Avatar implements ContainerUser {
         if (this.hasContainerOpen()) {
             this.doCloseContainer();
         }
+        final dev.tr7zw.entityculling.CullTask task = this.cullTask.getAndSet(null);
+        if (task != null) {
+            task.signalStop();
+        }
     }
 
     @Override
