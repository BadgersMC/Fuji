From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Sat, 13 Aug 2022 08:58:14 -0500
Subject: [PATCH] Slice: Smooth Teleports

26.4 compatibility: preserve optional smooth respawn path behind per-player flag and logical dimension-height check. Original Slice MIT implementation credited to Cryptite and HaHaWTH. Runtime client dimension-sync behavior not validated.

Co-authored-by: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 13c40e0ea42f08c7ff6b56c2826b7d25d79b021b..d4123fe68a31a0e442862d2497a07004cf25686c 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -449,6 +449,7 @@ public class ServerPlayer extends Player {
     private boolean tpsBar = false; // Purpur - Implement TPSBar
     private boolean compassBar = false; // Purpur - Add compass command
     private boolean ramBar = false; // Purpur - Implement rambar commands
+    public boolean smoothWorldTeleport; // Slice - opt-in to smooth respawn between compatible dimensions
 
     public ServerPlayer(final MinecraftServer server, final ServerLevel level, final GameProfile gameProfile, final ClientInformation clientInformation) {
         super(level, gameProfile);
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index ae60c092833fb1f366e00a020020ad16b31fba71..afb7af595271bbdfcff98df3c0f243378f863709 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -665,8 +665,10 @@ public abstract class PlayerList {
         byte dataToKeep = keepAllPlayerData ? ClientboundRespawnPacket.KEEP_ATTRIBUTE_MODIFIERS : 0;
         ServerLevel playerLevel = player.level();
         LevelData levelData = playerLevel.getLevelData();
+        if (!serverPlayer.smoothWorldTeleport || !isSameLogicalHeight((ServerLevel) fromLevel, level)) { // Leaf - Slice - Smooth Teleports
         player.connection.send(new ClientboundRespawnPacket(player.createCommonSpawnInfo(playerLevel), dataToKeep));
         player.connection.internalTeleport(player.getX(), player.getY(), player.getZ(), player.getYRot(), player.getXRot()); // Paper
+        } // Leaf - Slice - Smooth Teleports
         player.connection.send(new ClientboundSetDefaultSpawnPositionPacket(level.getRespawnData()));
         player.connection.send(new ClientboundChangeDifficultyPacket(levelData.getDifficulty(), levelData.isDifficultyLocked()));
         player.connection.send(new ClientboundSetExperiencePacket(player.experienceProgress, player.totalExperience, player.experienceLevel));
@@ -737,6 +739,8 @@ public abstract class PlayerList {
         return player;
     }
 
+    public static boolean isSameLogicalHeight(final ServerLevel fromLevel, final ServerLevel toLevel) { return fromLevel.getLogicalHeight() == toLevel.getLogicalHeight(); } // Leaf - Slice - Check world height before smooth teleport
+
     public void sendActivePlayerEffects(final ServerPlayer player) {
         this.sendActiveEffects(player, player.connection);
     }
