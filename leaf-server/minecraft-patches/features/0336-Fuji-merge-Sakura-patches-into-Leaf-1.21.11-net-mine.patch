diff --git a/me/samsuik/sakura/scheduler/TickTaskWithCallback.java b/me/samsuik/sakura/scheduler/TickTaskWithCallback.java
new file mode 100644
index 0000000000000000000000000000000000000000..898aefe231d873df6828d52d9c13d935bceaa372
--- /dev/null
+++ b/me/samsuik/sakura/scheduler/TickTaskWithCallback.java
@@ -0,0 +1,15 @@
+package me.samsuik.sakura.scheduler;
+
+import net.minecraft.server.level.ServerLevel;
+import org.jspecify.annotations.NullMarked;
+
+@NullMarked
+public interface TickTaskWithCallback extends TickTask {
