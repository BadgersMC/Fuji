From: BadgersMC <blrusso18@gmail.com>
Date: Thu, 18 Jun 2026 07:11:22 -0400
Subject: [PATCH] Fuji: add checkEntityVisibility to updatePlayerMulti (default
 tracker path)


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index c42a1f7c9e2d8c6399d3b201f057ac3fb5a29d01..8d0c0bc9f74414491125655263ca7b66fe152357 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1682,6 +1682,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 }
                 flag = flag && this.entity.broadcastToPlayer(player) && ChunkMap.this.isChunkTracked(player, this.entity.chunkPosition().x, this.entity.chunkPosition().z);
                 // Paper end - Configurable entity tracking range by Y
+                flag = flag && this.checkEntityVisibility(player); // Fuji - honor Sakura client visibility settings; updatePlayerMulti is Leaf's per-tick tracker path (moonrise$tick) and was missing this, breaking TNT/sand visibility with the default async-tracker-off config
                 // CraftBukkit start - respect vanish API
                 if (flag && !player.getBukkitEntity().canSeeChunkMapUpdatePlayer(this.entity.getBukkitEntity())) { // Paper - only consider hits // SparklyPaper - optimize canSee checks
                     flag = false;
