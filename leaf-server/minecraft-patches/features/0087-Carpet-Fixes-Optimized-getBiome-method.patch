From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nostalgic853 <yuu8583@proton.me>
Date: Tue, 25 Oct 2022 00:28:35 +0800
Subject: [PATCH] Carpet-Fixes: Optimized getBiome method

Frontier 26.4 safe subset: cache immutable quarter-offset values while preserving the vanilla biome corner-selection math and tie-breaking order. Full early-exit micro-optimization deferred until parity tests. Original project carpet-fixes, MIT; co-authored by HaHaWTH.

Co-authored-by: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>

diff --git a/net/minecraft/world/level/biome/BiomeManager.java b/net/minecraft/world/level/biome/BiomeManager.java
index c4ef951d1b1af6381c8d0e48b91dda601d6b98f1..0291089dd3e73631950a8f713d22d62504360efe 100644
--- a/net/minecraft/world/level/biome/BiomeManager.java
+++ b/net/minecraft/world/level/biome/BiomeManager.java
@@ -9,6 +9,8 @@ public class BiomeManager implements BiomeResolver, NoiseBiomeResolver {
     public static final int HALF_QUART = 2;
     private final NoiseBiomeResolver noiseBiomeSource;
     private final long biomeZoomSeed;
+    // Carpet-Fixes (26.4 safe subset): cached exact quarter offsets; biome corner selection remains unchanged.
+    private static final double[] QUART_OFFSETS = {0.0D, 0.25D, 0.5D, 0.75D};
 
     public BiomeManager(final NoiseBiomeResolver noiseBiomeSource, final long seed) {
         this.noiseBiomeSource = noiseBiomeSource;
@@ -27,9 +29,9 @@ public class BiomeManager implements BiomeResolver, NoiseBiomeResolver {
         int parentX = absX >> 2;
         int parentY = absY >> 2;
         int parentZ = absZ >> 2;
-        double fractX = (absX & 3) / 4.0;
-        double fractY = (absY & 3) / 4.0;
-        double fractZ = (absZ & 3) / 4.0;
+        double fractX = QUART_OFFSETS[absX & 3];
+        double fractY = QUART_OFFSETS[absY & 3];
+        double fractZ = QUART_OFFSETS[absZ & 3];
         int minI = 0;
         double minFiddledDistance = Double.POSITIVE_INFINITY;
 
