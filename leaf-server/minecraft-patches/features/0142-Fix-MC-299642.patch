From 514da68dfcd43e03e8d6af2baca437365ca8257a Mon Sep 17 00:00:00 2001
From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:25:45 -0500
Subject: [PATCH] Fix MC-299642

Frontier 26.4 adapts NoGravity turtle movement fix to current addDeltaMovement API, preserving Purpur rideable controls.
---
 net/minecraft/world/entity/animal/turtle/Turtle.java | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/net/minecraft/world/entity/animal/turtle/Turtle.java b/net/minecraft/world/entity/animal/turtle/Turtle.java
index 0e22182..ac23ca4 100644
--- a/net/minecraft/world/entity/animal/turtle/Turtle.java
+++ b/net/minecraft/world/entity/animal/turtle/Turtle.java
@@ -574,9 +574,14 @@ public class Turtle extends Animal {
                     float yRotD = (float)(Mth.atan2(zd, xd) * 180.0F / (float)Math.PI) - 90.0F;
                     this.mob.setYRot(this.rotlerp(this.mob.getYRot(), yRotD, 90.0F));
                     this.mob.yBodyRot = this.mob.getYRot();
-                    float targetSpeed = (float)(this.getSpeedModifier() * this.mob.getAttributeValue(Attributes.MOVEMENT_SPEED)); // Purpur - Ridables
-                    this.mob.setSpeed(Mth.lerp(0.125F, this.mob.getSpeed(), targetSpeed));
-                    this.mob.addDeltaMovement(0.0, this.mob.getSpeed() * yd * 0.1, 0.0);
+                    // Leaf - MC-299642: avoid bypassing NoGravity with ground/air movement control.
+                    if (!this.mob.isNoGravity() || this.mob.isInWater()) {
+                        float targetSpeed = (float)(this.getSpeedModifier() * this.mob.getAttributeValue(Attributes.MOVEMENT_SPEED)); // Purpur - Ridables
+                        this.mob.setSpeed(Mth.lerp(0.125F, this.mob.getSpeed(), targetSpeed));
+                        this.mob.addDeltaMovement(0.0, this.mob.getSpeed() * yd * 0.1, 0.0);
+                    } else {
+                        this.mob.setSpeed(0.0F);
+                    }
                 }
             } else {
                 this.mob.setSpeed(0.0F);
-- 
