Frontier 26.4 compatibility: adapted the optional multiple-challenge path to its legacy single-challenge listener. Disabled by default, preserving standard keepalive behavior.

diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index ec48c3cd3efc252d09d3fe06056822cd0f439f9d..7153f2a8ee92461b07ab4098e10730be9b485257 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -47,6 +47,8 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     private long keepAliveTime;
     private boolean keepAlivePending;
     private long keepAliveChallenge;
+    private final it.unimi.dsi.fastutil.longs.LongList pendingGaleKeepAlives = new it.unimi.dsi.fastutil.longs.LongArrayList(); // Gale - Purpur multi keepalives
+    private boolean lastGaleKeepAliveMode;
     private long closedListenerTime;
     private boolean closed = false;
     private int latency;
@@ -111,6 +113,16 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
 
     @Override
     public void handleKeepAlive(final ServerboundKeepAlivePacket packet) {
+        if (org.galemc.gale.configuration.GaleGlobalConfiguration.get().misc.keepalive.sendMultiple) {
+            // Gale - Allow responses to any outstanding challenge, discarding stale challenges after a valid response.
+            if (this.keepAlivePending && this.pendingGaleKeepAlives.contains(packet.getId())) {
+                final int ping = (int)(Util.getMillis() - packet.getId());
+                this.latency = (this.latency * 3 + ping) / 4;
+                this.keepAlivePending = false;
+                this.pendingGaleKeepAlives.clear();
+            }
+            return;
+        }
         if (this.keepAlivePending && packet.getId() == this.keepAliveChallenge) {
             int time = (int)(Util.getMillis() - this.keepAliveTime);
             this.latency = (this.latency * 3 + time) / 4;
@@ -250,6 +262,29 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     protected void keepConnectionAlive() {
         Profiler.get().push("keepAlive");
         long now = Util.getMillis();
+        // Gale - Purpur alternative keepalives adapted to Frontier 26.4's single-challenge implementation.
+        final boolean multi = org.galemc.gale.configuration.GaleGlobalConfiguration.get().misc.keepalive.sendMultiple;
+        if (multi != this.lastGaleKeepAliveMode) {
+            this.keepAlivePending = false;
+            this.pendingGaleKeepAlives.clear();
+            this.keepAliveTime = now;
+            this.lastGaleKeepAliveMode = multi;
+        }
+        if (multi) {
+            if (!this.isSingleplayerOwner() && this.checkIfClosed(now)) {
+                if (this.keepAlivePending && !this.pendingGaleKeepAlives.isEmpty()
+                    && now - this.pendingGaleKeepAlives.getLong(0) >= KEEPALIVE_LIMIT) {
+                    this.disconnect(TIMEOUT_DISCONNECTION_MESSAGE, io.papermc.paper.connection.DisconnectionReason.TIMEOUT);
+                } else if (now - this.keepAliveTime >= 1000L) {
+                    this.keepAliveTime = now;
+                    this.keepAlivePending = true;
+                    this.pendingGaleKeepAlives.add(now);
+                    this.send(new ClientboundKeepAlivePacket(now));
+                }
+            }
+            Profiler.get().pop();
+            return;
+        }
         // Paper start - give clients a longer time to respond to pings as per pre 1.12.2 timings
         // This should effectively place the keepalive handling back to "as it was" before 1.12.2
         final long elapsedTime = now - this.keepAliveTime;
