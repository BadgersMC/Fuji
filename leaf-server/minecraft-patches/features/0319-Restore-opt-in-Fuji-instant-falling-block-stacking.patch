From ccf1d5ba0451693da4a2b8b6f25c9726ffb77c6c Mon Sep 17 00:00:00 2001
From: BadgersMC <blrusso18@gmail.com>
Date: Fri, 13 Nov 2026 15:39:24 -0500
Subject: [PATCH] Restore opt-in Fuji instant falling block stacking

Frontier Paper 26.4 safe adaptation: optional bounded same-column stack for sand, red sand, gravel and concrete powder, using native falling-block lifecycle. Preserve source and destination Bukkit events, require loaded chunk, never remove another falling entity, and use normal falling entity on any refused placement. Experimental and off by default; cannon/runtime parity not verified.
---
 .../world/entity/item/FallingBlockEntity.java | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/net/minecraft/world/entity/item/FallingBlockEntity.java b/net/minecraft/world/entity/item/FallingBlockEntity.java
index a281f4f..587f5b2 100644
--- a/net/minecraft/world/entity/item/FallingBlockEntity.java
+++ b/net/minecraft/world/entity/item/FallingBlockEntity.java
@@ -98,10 +98,55 @@ public class FallingBlockEntity extends Entity {
         );
         if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, pos, state.getFluidState().createLegacyBlock())) return entity; // CraftBukkit
         level.setBlockAndUpdate(pos, state.getFluidState().createLegacyBlock());
+        // Fuji - optional, bounded sand/concrete-powder stacking; fall back to vanilla entity on failure.
+        if (org.dreeam.leaf.config.modules.gameplay.InstantFallingBlocks.enabled
+            && fuji$attemptInstantStack(level, pos, state, entity)) {
+            return entity;
+        }
         level.addFreshEntity(entity);
         return entity;
     }
 
+    // Fuji Frontier 26.4: no forced chunk loads, no other falling entities removed,
+    // and both source and destination changes honor CraftBukkit entity-change events.
+    private static boolean fuji$attemptInstantStack(final Level level, final BlockPos origin,
+                                                     final BlockState state, final FallingBlockEntity entity) {
+        // Limit the experimental mechanic to cannon ammunition, never anvils, dragon eggs or tile data.
+        final Block fallingBlock = state.getBlock();
+        final boolean supportedAmmo = fallingBlock == Blocks.SAND || fallingBlock == Blocks.RED_SAND
+            || fallingBlock == Blocks.GRAVEL || fallingBlock instanceof ConcretePowderBlock;
+        if (!(level instanceof ServerLevel serverLevel) || !supportedAmmo
+            || state.hasBlockEntity() || !serverLevel.hasChunk(origin.getX() >> 4, origin.getZ() >> 4)) {
+            return false;
+        }
+
+        final BlockPos.MutableBlockPos cursor = origin.mutable();
+        for (int distance = 1; distance <= 20; distance++) {
+            cursor.move(0, -1, 0);
+            if (cursor.getY() < level.getMinY()) {
+                break;
+            }
+            final BlockState below = level.getBlockState(cursor);
+            if (below.isAir()) {
+                continue;
+            }
+            if (distance == 1 || !below.is(state.getBlock())) {
+                return false;
+            }
+
+            final BlockPos destination = cursor.above();
+            if (!level.getBlockState(destination).isAir()
+                || !org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, destination, state)
+                || !level.getBlockState(destination).isAir()) {
+                return false;
+            }
+            // Source has already been replaced by the normal falling-block transition.
+            // A failed destination placement returns false so the caller spawns the usual entity.
+            return level.setBlock(destination, state, Block.UPDATE_ALL, 2);
+        }
+        return false;
+    }
+
     @Override
     public boolean isAttackable() {
         return false;
