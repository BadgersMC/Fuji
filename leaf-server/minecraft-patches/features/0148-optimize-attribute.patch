From 138a15cf49bc039a0ac1006db197bd4687fb01cb Mon Sep 17 00:00:00 2001
From: hayanesuru <hayanesuru@outlook.jp>
Date: Fri, 13 Nov 2026 15:27:14 -0500
Subject: [PATCH] optimize attribute

Frontier Paper 26.4 safe subset: replace stream with single pass for syncable attribute collection, preserving Purpur filtering and existing dirty-set clear lifecycle. The original ID-indexed array-map replacement is deferred until packet parity and reload tests.
---
 .../world/entity/ai/attributes/AttributeMap.java       | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/net/minecraft/world/entity/ai/attributes/AttributeMap.java b/net/minecraft/world/entity/ai/attributes/AttributeMap.java
index c075423..985dc55 100644
--- a/net/minecraft/world/entity/ai/attributes/AttributeMap.java
+++ b/net/minecraft/world/entity/ai/attributes/AttributeMap.java
@@ -46,7 +46,15 @@ public class AttributeMap {
     }
 
     public Collection<AttributeInstance> getSyncableAttributes() {
-        return this.attributes.values().stream().filter(instance -> instance.getAttribute().value().isClientSyncable() && (entity == null || entity.shouldSendAttribute(instance.getAttribute().value()))).collect(Collectors.toList()); // Purpur - Ridables
+        // Leaf - safe 26.4 subset: avoid stream allocation, preserve Purpur's attribute filtering.
+        final List<AttributeInstance> syncable = new ArrayList<>(this.attributes.size());
+        for (final AttributeInstance instance : this.attributes.values()) {
+            if (instance.getAttribute().value().isClientSyncable()
+                && (this.entity == null || this.entity.shouldSendAttribute(instance.getAttribute().value()))) {
+                syncable.add(instance);
+            }
+        }
+        return syncable;
     }
 
     public @Nullable AttributeInstance getInstance(final Holder<Attribute> attribute) {
