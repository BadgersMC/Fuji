+    private void addToSendAllPlayerInfoBuckets(final ServerPlayer player) {
+        final int index = player.sendAllPlayerInfoBucketIndex;
+        final ServerPlayer[] old = this.sendAllPlayerInfoBuckets[index];
+        if (old == null) {
+            this.sendAllPlayerInfoBuckets[index] = new ServerPlayer[] {player};
+        } else {
+            final ServerPlayer[] updated = java.util.Arrays.copyOf(old, old.length + 1);
+            updated[old.length] = player;
+            this.sendAllPlayerInfoBuckets[index] = updated;
+        }
+    }
+
+    private void removeFromSendAllPlayerInfoBuckets(final ServerPlayer player) {
+        final int index = player.sendAllPlayerInfoBucketIndex;
+        final ServerPlayer[] old = this.sendAllPlayerInfoBuckets[index];
+        if (old == null) return;
+        for (int i = 0; i < old.length; i++) {
+            if (old[i] == player) {
+                if (old.length == 1) {
+                    this.sendAllPlayerInfoBuckets[index] = null;
+                } else {
+                    final ServerPlayer[] updated = new ServerPlayer[old.length - 1];
+                    System.arraycopy(old, 0, updated, 0, i);
+                    System.arraycopy(old, i + 1, updated, i, old.length - i - 1);
+                    this.sendAllPlayerInfoBuckets[index] = updated;
+                }
+                return;
+            }
+        }
+    }
+
