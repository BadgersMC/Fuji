From 7667a2aaada8705f1d3d8e0497de3a591d467919 Mon Sep 17 00:00:00 2001
From: Dreeam <61569423+Dreeam-qwq@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:22:37 -0500
Subject: [PATCH] Replace Entity active effects map with optimized collection

Frontier 26.4 safe subset: reuse active-effect values view across particle and ambient updates. Keep default map implementation until benchmarks and Bukkit API threading review. Original Leaf optimization author Dreeam.
---
 net/minecraft/world/entity/LivingEntity.java | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 355978b..9f8e5bb 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1020,14 +1020,15 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     private void updateSynchronizedMobEffectParticles() {
         // Leaf start - Remove stream in entity visible effects filter
         List<ParticleOptions> visibleEffectParticles = new java.util.ArrayList<>();
-        for (MobEffectInstance effect : this.activeEffects.values()) {
+        final Collection<MobEffectInstance> effectsValues = this.activeEffects.values(); // Leaf - reuse the collection view
+        for (MobEffectInstance effect : effectsValues) {
             if (effect.isVisible()) {
                 visibleEffectParticles.add(effect.getParticleOptions());
             }
         }
         // Leaf end - Remove stream in entity visible effects filter
         this.entityData.set(DATA_EFFECT_PARTICLES, visibleEffectParticles);
-        this.entityData.set(DATA_EFFECT_AMBIENCE_ID, areAllEffectsAmbient(this.activeEffects.values()));
+        this.entityData.set(DATA_EFFECT_AMBIENCE_ID, areAllEffectsAmbient(effectsValues));
     }
 
     private void updateGlowingStatus() {
-- 
