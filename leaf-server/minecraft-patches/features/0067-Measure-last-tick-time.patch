diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index ec8e1210a42f207abf95ff76c623db8da3a3e01f..898da0b441fd3de62ec501cf886f95b45d4bdb19 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1131,6 +1131,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     }
 
     private void recordTaskExecutionTimeWhileWaiting() {
+        final long tickOversleepStart = System.nanoTime(); // Gale - measure task-wait interval
         final ProfilerFiller profiler = Profiler.get();
 
         profiler.push("moonrise:execute_tasks_until_tick");
@@ -1167,12 +1168,16 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 }
             }
         } finally {
+            lastTickOversleepTime = (System.nanoTime() - tickOversleepStart) / 1_000_000L; // Gale - last tick waiting time
             this.waitingForNextTick = false;
         }
         profiler.pop();
     }
     // Paper end - improve tick loop
 
+    public static volatile long lastTickProperTime; // Gale - elapsed server tick time in milliseconds
+    public static volatile long lastTickOversleepTime; // Gale - elapsed task-wait interval in milliseconds
+
     protected void runServer() {
         try {
             if (!this.initServer()) {
@@ -1577,7 +1582,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.tickFrame.start();
         // Paper - improve tick loop - moved into runAllTasksAtTickStart
         this.runAllTasksAtTickStart(); // Paper - improve tick loop
+        final long tickProperStart = System.nanoTime(); // Gale - measure tick work
         this.tickServer(sprinting ? () -> false : this::haveTime);
+        lastTickProperTime = (System.nanoTime() - tickProperStart) / 1_000_000L; // Gale - elapsed tick work
         this.tickFrame.end();
         this.recordEndOfTick(); // Paper - improve tick loop
         profiler.pop();
