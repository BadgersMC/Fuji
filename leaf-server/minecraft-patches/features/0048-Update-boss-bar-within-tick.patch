diff --git a/net/minecraft/world/entity/raid/Raid.java b/net/minecraft/world/entity/raid/Raid.java
index 2955ee18d5f3dbff3f35bf99a7f2a21a4eae3314..5b2f55dd8390ed97c67cda912a6599dcc0230bef 100644
--- a/net/minecraft/world/entity/raid/Raid.java
+++ b/net/minecraft/world/entity/raid/Raid.java
@@ -132,6 +132,7 @@ public class Raid {
     private Raid.RaidStatus status;
     private int celebrationTicks;
     private Optional<BlockPos> waveSpawnPos = Optional.empty();
+    private boolean isBarDirty; // Gale - Lithium: update raid boss bar within tick
 
     public Raid(final BlockPos center, final Difficulty difficulty) {
         this.active = true;
@@ -284,6 +285,10 @@ public class Raid {
     }
 
     public void tick(final ServerLevel level) {
+        if (this.isBarDirty) {
+            this.updateBossbarInternal();
+            this.isBarDirty = false;
+        }
         if (!this.isStopped()) {
             if (this.status == Raid.RaidStatus.ONGOING) {
                 boolean oldActive = this.active;
@@ -617,6 +622,10 @@ public class Raid {
     }
 
     public void updateBossbar() {
+        this.isBarDirty = true;
+    }
+
+    private void updateBossbarInternal() {
         this.raidEvent.setProgress(Math.clamp(this.getHealthOfLivingRaiders() / this.totalHealth, 0.0F, 1.0F));
     }
 
