From aa87c814fbb514bb47580bf7ad2872b3ade81605 Mon Sep 17 00:00:00 2001
From: BadgersMC <blrusso18@gmail.com>
Date: Fri, 13 Nov 2026 15:42:12 -0500
Subject: [PATCH] Use the captured safe ender pearl destination for the sound

Frontier Paper 26.4 compatibility: use the actual result of the Bukkit-approved teleport (newOwner world/position), not the original pearl impact location. Original captured-safe position variable was removed by 26.4 flow; avoids sound playing in a different dimension if a plugin redirects the teleport. Source-only, no runtime parity tests.
---
 .../projectile/throwableitemprojectile/ThrownEnderpearl.java   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
index 3583087..8765dc6 100644
--- a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
+++ b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
@@ -140,7 +140,8 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
                             newOwner.hurtServer(player.level(), this.damageSources().enderPearl().eventEntityDamager(this), this.level().purpurConfig.enderPearlDamage); // CraftBukkit // Paper - fix DamageSource API // Purpur - Configurable Ender Pearl damage
                         }
 
-                        this.playSound(level, teleportPos);
+                        // Fuji - use the actual Bukkit-approved teleport destination, including world changes.
+                        this.playSound(newOwner.level(), newOwner.position());
                     }
                 } else {
                     Entity newOwner = owner.teleport(
