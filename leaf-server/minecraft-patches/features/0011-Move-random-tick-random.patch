From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Fri, 13 Nov 2026 07:11:31 -0500
Subject: [PATCH] Move random tick random

License: GPL-3.0-only; original Gale/Pufferfish patch. Frontier Paper 26.4 no longer has the old ServerLevel simpleRandom field. Expose a per-world RandomSource for the following optimized lightning counter patch.

diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 93dfc9904cce02f81b6d60b41ef4f02053384807..bba3ed8d202122f7d9a905641b28c932bc0613f5 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -169,6 +169,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable {
     public static @Nullable BlockPos lastPhysicsProblem; // Spigot
     public final Map<ServerExplosion.CacheKey, Float> explosionDensityCache = new java.util.HashMap<>(); // Paper - Optimize explosions
     public java.util.ArrayDeque<net.minecraft.world.level.block.RedstoneTorchBlock.Toggle> redstoneUpdateInfos; // Paper - Faster redstone torch rapid clock removal; Move from Map in BlockRedstoneTorch to here
+    public final net.minecraft.util.RandomSource simpleRandom = net.minecraft.util.RandomSource.create(); // Gale / Pufferfish - per-world RNG for fast chunk tick scheduling
 
     // Purpur start - Add adjustable breeding cooldown to config
     private com.google.common.cache.Cache<BreedingCooldownPair, Object> playerBreedingCooldowns;
