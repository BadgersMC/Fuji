From 3152b1fa8639937e19d39312515dd9c2beffb8ca Mon Sep 17 00:00:00 2001
From: Taiyou06 <kaandindar21@gmail.com>
Date: Fri, 13 Nov 2026 15:21:31 -0500
Subject: [PATCH] Remove stream in GateBehavior

Frontier 26.4: replace stream.noneMatch on active child behavior with equivalent early-exit iterator. Preserve Paper ShufflingList semantics and original Leaf author.
---
 .../world/entity/ai/behavior/GateBehavior.java         | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/net/minecraft/world/entity/ai/behavior/GateBehavior.java b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
index c16463f..eb94b15 100644
--- a/net/minecraft/world/entity/ai/behavior/GateBehavior.java
+++ b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
@@ -79,7 +79,15 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
     @Override
     public final void tickOrStop(final ServerLevel level, final E body, final long timestamp) {
         this.behaviors.stream().filter(goal -> goal.getStatus() == Behavior.Status.RUNNING).forEach(goal -> goal.tickOrStop(level, body, timestamp));
-        if (this.behaviors.stream().noneMatch(g -> g.getStatus() == Behavior.Status.RUNNING)) {
+        // Leaf - no stream allocation when checking whether any behavior is still running.
+        boolean running = false;
+        for (final BehaviorControl<? super E> goal : this.behaviors) {
+            if (goal.getStatus() == Behavior.Status.RUNNING) {
+                running = true;
+                break;
+            }
+        }
+        if (!running) {
             this.doStop(level, body, timestamp);
         }
     }
-- 
