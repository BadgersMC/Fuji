@@ -0,0 +1,38 @@
+package me.samsuik.sakura;
+
+import io.papermc.paper.configuration.type.time.Duration;
+import me.samsuik.sakura.command.subcommand.FPSCommand;
+import me.samsuik.sakura.command.subcommand.VisualCommand;
+import me.samsuik.sakura.player.visibility.VisibilityTypes;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.resources.Identifier;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.level.Level;
+import org.bukkit.command.Command;
+import org.jspecify.annotations.NullMarked;
+
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.TimeUnit;
+
+@NullMarked
+public final class SakuraFeatureHooks {
+    public static void setupCommands(final Map<String, Command> commands) {
+        // Sakura start - client visibility settings
+        commands.put("fps", new FPSCommand("fps"));
+        commands.put("tntvisibility", new VisualCommand(VisibilityTypes.TNT, "tnttoggle"));
+        commands.put("sandvisibility", new VisualCommand(VisibilityTypes.SAND, "sandtoggle"));
+        // Sakura end - client visibility settings
+    }
+
+    public static void setDurableMaterialExpiration(final Identifier worldIdentifier, final Duration duration) {
+        getLevel(worldIdentifier).ifPresent(level -> level.durabilityManager.updateExpirationTimer(duration.seconds(), TimeUnit.SECONDS)); // Sakura - explosion durable blocks
+    }
+
+    private static Optional<Level> getLevel(final Identifier worldIdentifier) {
+        final ResourceKey<Level> dimensionKey = ResourceKey.create(Registries.DIMENSION, worldIdentifier);
+        final Level level = MinecraftServer.getServer().getLevel(dimensionKey);
+        return Optional.ofNullable(level);
+    }
+}
