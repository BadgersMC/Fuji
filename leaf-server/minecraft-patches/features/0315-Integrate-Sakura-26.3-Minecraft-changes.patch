@@ -0,0 +1,82 @@
+package me.samsuik.sakura.redstone;
+
+import com.google.common.cache.Cache;
+import com.google.common.cache.CacheBuilder;
+import me.samsuik.sakura.redstone.network.RedstoneNetwork;
+import me.samsuik.sakura.redstone.network.RedstoneSourceKey;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.Level;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.time.Duration;
+
+@SuppressWarnings("DataFlowIssue")
+@NullMarked
+public final class RedstoneWireCache {
+    private final Cache<RedstoneSourceKey, RedstoneNetwork> redstoneNetworks = CacheBuilder.newBuilder()
+        .removalListener(notification -> ((RedstoneNetwork) notification.getValue()).unregister())
+        .expireAfterAccess(Duration.ofSeconds(30))
+        .maximumSize(8192)
+        .build();
+    private @Nullable TrackedRedstoneChanges redstoneChanges;
+    private @Nullable RedstoneNetwork applyingRedstoneNetwork;
+
+    public boolean isApplyingNetwork() {
+        return this.applyingRedstoneNetwork != null;
+    }
+
+    public boolean isUpdatingRedstone(final BlockPos pos) {
+        return this.isApplyingNetwork() && this.applyingRedstoneNetwork.isWirePos(pos);
+    }
+
+    public void wirePower(final BlockPos redstoneWirePos, final int oldPower, final int newPower) {
+        if (this.redstoneChanges != null) {
+            this.redstoneChanges.addWireUpdate(redstoneWirePos, oldPower, newPower);
+        }
+    }
+
+    public void singleNeighborUpdate(final BlockPos updatePos) {
+        if (this.redstoneChanges != null) {
+            this.redstoneChanges.addNeighborUpdate(updatePos, true);
+        }
+    }
+
+    public void neighborUpdates(final BlockPos updatePos) {
+        if (this.redstoneChanges != null) {
+            this.redstoneChanges.addNeighborUpdate(updatePos, false);
+        }
+    }
+
+    /**
+     * Tries to apply a cached redstone network. If that isn't possible then
+     * it caches the existing network.
+     *
+     * @return if applied successfully
+     */
+    public boolean cache(final Level level, final RedstoneSourceKey sourceKey) {
+        final RedstoneNetwork redstoneNetwork = this.redstoneNetworks.getIfPresent(sourceKey);
+        try {
+            this.applyingRedstoneNetwork = redstoneNetwork;
+            if (redstoneNetwork != null && redstoneNetwork.apply(level)) {
+                return true;
+            }
+        } finally {
+            this.applyingRedstoneNetwork = null;
+        }
+
+        if (this.redstoneChanges == null) {
+            this.redstoneChanges = new TrackedRedstoneChanges(level, sourceKey);
+        }
+
+        return false;
+    }
+
+    public void cacheNetwork() {
+        final TrackedRedstoneChanges redstoneChanges = this.redstoneChanges;
+        if (redstoneChanges != null) {
+            this.redstoneNetworks.put(redstoneChanges.getSourceKey(), redstoneChanges.createNetwork());
+            this.redstoneChanges = null;
+        }
+    }
+}
diff --git a/me/samsuik/sakura/redstone/TrackedRedstoneChanges.java b/me/samsuik/sakura/redstone/TrackedRedstoneChanges.java
new file mode 100644
index 0000000000000000000000000000000000000000..43a89714d707935140bc19f497af0aac62597c38
--- /dev/null
+++ b/me/samsuik/sakura/redstone/TrackedRedstoneChanges.java
@@ -0,0 +1,145 @@
+package me.samsuik.sakura.redstone;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap;
+import it.unimi.dsi.fastutil.objects.Object2ObjectLinkedOpenHashMap;
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import me.samsuik.sakura.redstone.network.RedstoneNetwork;
+import me.samsuik.sakura.redstone.network.RedstoneSourceKey;
+import me.samsuik.sakura.redstone.network.RedstoneWireState;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.redstone.NeighborUpdater;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.BitSet;
+import java.util.List;
+import java.util.Map;
+
+@NullMarked
+public final class TrackedRedstoneChanges {
+    private final Map<BlockPos, RedstoneWireState> redstoneChanges = new Object2ObjectLinkedOpenHashMap<>();
+    private final List<RedstoneWireState> redstoneUpdates = new ObjectArrayList<>();
+    private final List<BlockPos> neighborUpdates = new ObjectArrayList<>();
+    private final RedstoneSourceKey sourceKey;
+    private final Level level;
+
+    public TrackedRedstoneChanges(final Level level, final RedstoneSourceKey sourceKey) {
+        this.level = level;
+        this.sourceKey = sourceKey;
+    }
+
+    public void addWireUpdate(final BlockPos wirePos, final int oldPower, final int newPower) {
+        final RedstoneWireState redstoneWireState = new RedstoneWireState(
+            wirePos,
+            oldPower,
+            newPower,
+            false,
+            false,
+            this.neighborUpdates.size()
+        );
+
+        this.redstoneChanges.compute(wirePos, (_, state) -> {
+            if (state == null) {
+                return redstoneWireState;
+            }
+
+            return state.newPower(newPower);
+        });
+
+        this.redstoneUpdates.add(redstoneWireState);
+    }
+
+    public void addNeighborUpdate(final BlockPos updatePos, final boolean single) {
+        if (single) {
+            this.neighborUpdates.add(updatePos);
+            return;
+        }
+
+        for (final Direction direction : NeighborUpdater.UPDATE_ORDER) {
+            this.neighborUpdates.add(updatePos.relative(direction));
+        }
+    }
+
+    public RedstoneSourceKey getSourceKey() {
+        return this.sourceKey;
+    }
+
+    public @Nullable RedstoneNetwork createNetwork() {
+        final Level level = this.level;
+        final boolean fullDeduplication = this.sourceKey.deduplicate();
+
+        final List<RedstoneWireState> redstoneUpdates = this.redstoneUpdates;
+        final Object2IntOpenHashMap<BlockPos> wireIndexes = new Object2IntOpenHashMap<>();
+        wireIndexes.defaultReturnValue(-1);
+
+        for (int wireIndex = redstoneUpdates.size() - 1; wireIndex >= 0; wireIndex--) {
+            final RedstoneWireState redstoneUpdate = redstoneUpdates.get(wireIndex);
+            final BlockPos wirePos = redstoneUpdate.position();
+
+            // It's possible for the block below the redstone to break while the network is updating
+            final BlockState blockStateBelow = level.getBlockState(wirePos.below());
+            if (blockStateBelow.is(Blocks.PISTON_HEAD) || blockStateBelow.is(BlockTags.TRAPDOORS)) {
+                return null;
+            }
+
+            // Filter out wires updates that are not the first and last update
+            if (fullDeduplication && redstoneUpdate.isRedundantWireUpdate(this.redstoneChanges.get(wirePos))) {
+                redstoneUpdates.set(wireIndex, redstoneUpdate.skip(true));
+            }
+
+            wireIndexes.put(wirePos, wireIndex);
+        }
+
+        final List<BlockPos> neighborUpdates = this.neighborUpdates;
+        final BitSet redundantUpdates = new BitSet(neighborUpdates.size());
+
+        for (int updateIndex = 0; updateIndex < neighborUpdates.size(); ++updateIndex) {
+            final BlockPos updatePos = neighborUpdates.get(updateIndex);
+            final BlockState state = level.getBlockState(updatePos);
+            final Block block = state.getBlock();
+
+            // Filter out redundant neighbor updates
+            if (!RedstoneBlockUtil.needsRedstoneUpdate(state)) {
+                redundantUpdates.set(updateIndex);
+            }
+
+            // Never update redstone wires tracked by the network
+            if (state.is(Blocks.REDSTONE_WIRE) && wireIndexes.containsKey(updatePos)) {
+                neighborUpdates.set(updateIndex, null);
+                continue;
+            }
+
+            // Look for blocks that actually need shape updates
+            if (RedstoneBlockUtil.needsShapeUpdate(state, block)) {
+                for (final Direction direction : NeighborUpdater.UPDATE_ORDER) {
+                    final int neighborWireIndex = wireIndexes.getInt(updatePos.relative(direction));
+                    if (neighborWireIndex < 0) {
+                        continue;
+                    }
+
+                    final RedstoneWireState neighborWireState = redstoneUpdates.get(neighborWireIndex);
+                    redstoneUpdates.set(neighborWireIndex, neighborWireState.updateShapes(true));
+                }
+            }
+        }
+
+        if (fullDeduplication) {
+            final LongOpenHashSet updates = new LongOpenHashSet(wireIndexes.size() * 4);
+            for (int updateIndex = neighborUpdates.size() - 1; updateIndex >= 0; --updateIndex) {
+                final BlockPos updatePos = neighborUpdates.get(updateIndex);
+                if (updatePos != null && !updates.add(updatePos.asLong())) {
+                    neighborUpdates.set(updateIndex, null);
+                }
+            }
+        }
+
+        return new RedstoneNetwork(this.redstoneChanges, redstoneUpdates, neighborUpdates, redundantUpdates, level.blockStateChangeTracker);
+    }
+}
diff --git a/me/samsuik/sakura/redstone/network/RedstoneNetwork.java b/me/samsuik/sakura/redstone/network/RedstoneNetwork.java
