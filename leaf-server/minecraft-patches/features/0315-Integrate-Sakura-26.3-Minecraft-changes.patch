@@ -0,0 +1,47 @@
+package me.samsuik.sakura.utils;
+
+import it.unimi.dsi.fastutil.HashCommon;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.Arrays;
+
+@SuppressWarnings("unchecked")
+@NullMarked
+public final class SimpleHashTable<K, V> {
+    private final @Nullable V[] table;
+    private final int mask;
+
+    public SimpleHashTable(final int expectedSize) {
+        if (expectedSize < 0) {
+            throw new IllegalArgumentException("Table size cannot be negative");
+        } else {
+            final int size = HashCommon.nextPowerOfTwo(expectedSize - 1);
+            this.table = (V[]) new Object[size];
+            this.mask = (size - 1);
+        }
+    }
+
+    private int index(final K key) {
+        return key.hashCode() & this.mask;
+    }
+
+    public @Nullable V get(final K key) {
+        return this.table[this.index(key)];
+    }
+
+    public @Nullable V put(final K key, final @Nullable V value) {
+        final int index = this.index(key);
+        final V present = this.table[index];
+        this.table[index] = value;
+        return present;
+    }
+
+    public @Nullable V remove(final K key) {
+        return this.put(key, null);
+    }
+
+    public void clear() {
+        Arrays.fill(this.table, null);
+    }
+}
diff --git a/me/samsuik/sakura/utils/collections/SlotCountingItemList.java b/me/samsuik/sakura/utils/collections/SlotCountingItemList.java
new file mode 100644
index 0000000000000000000000000000000000000000..2b6b47edf541bfef01f1ee7fa14397158a93eb28
--- /dev/null
+++ b/me/samsuik/sakura/utils/collections/SlotCountingItemList.java
@@ -0,0 +1,134 @@
+package me.samsuik.sakura.utils.collections;
+
+import me.samsuik.sakura.tracking.ChangeListener;
+import net.minecraft.core.NonNullList;
+import net.minecraft.world.item.ItemStack;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Item list that keeps track of empty and full slots.
+ */
+@NullMarked
+public final class SlotCountingItemList extends NonNullList<ItemStack> {
+    public static SlotCountingItemList withSize(final int size, final @Nullable ItemStack defaultItem) {
+        final ItemStack[] items = new ItemStack[size];
+        Arrays.fill(items, defaultItem);
+        return new SlotCountingItemList(Arrays.asList(items), defaultItem);
+    }
+
+    public static SlotCountingItemList copy(final NonNullList<ItemStack> items) {
+        final SlotCountingItemList itemList = withSize(items.size(), items.defaultValue);
+        for (int index = 0; index < items.size(); ++index) {
+            itemList.set(index, items.get(index));
+        }
+
+        return itemList;
+    }
+
+    private final @Nullable ItemWatcher[] watchers;
+    private int emptySlots;
+    private int fullSlots;
+
+    SlotCountingItemList(final List<ItemStack> items, final @Nullable ItemStack defaultItem) {
+        super(items, defaultItem);
+        this.watchers = new ItemWatcher[items.size()];
+        this.recalculate();
+    }
+
+    private void recalculate() {
+        this.emptySlots = this.size();
+        this.fullSlots = 0;
+
+        for (int slot = 0; slot < this.size(); ++slot) {
+            this.updateItem(slot, ItemStack.EMPTY, this.get(slot));
+        }
+    }
+
+    private void updateItem(final int index, final ItemStack oldItemStack, final ItemStack newItemStack) {
+        final ItemWatcher watcher = this.watchers[index];
+        if (watcher != null) {
+            oldItemStack.unwatch(watcher);
+        }
+
+        if (!newItemStack.isEmpty()) {
+            this.watchers[index] = new ItemWatcher(newItemStack);
+        }
+
+        final boolean oldEmpty = oldItemStack.isEmpty();
+        final boolean oldFull  = oldItemStack.getCount() == oldItemStack.getMaxStackSize();
+        this.updateCounts(oldEmpty, oldFull, newItemStack);
+    }
+
+    private void updateCounts(final boolean oldItemEmpty, final boolean oldItemFull, final ItemStack itemStack) {
+        if (oldItemEmpty != itemStack.isEmpty()) {
+            this.emptySlots += oldItemEmpty ? -1 : 1;
+        }
+
+        if (oldItemFull != (itemStack.getCount() == itemStack.getMaxStackSize())) {
+            this.fullSlots += oldItemFull ? -1 : 1;
+        }
+    }
+
+    public boolean isEmpty() {
+        return this.emptySlots == this.size();
+    }
+
+    public boolean isFull() {
+        return this.fullSlots == this.size();
+    }
+
+    public boolean hasSpaceAvailable() {
+        return this.fullSlots != this.size();
+    }
+
+    @Override
+    public ItemStack set(final int index, final ItemStack newItemStack) {
+        final ItemStack oldItemStack = super.set(index, newItemStack);
+        this.updateItem(index, oldItemStack, newItemStack);
+
+        return oldItemStack;
+    }
+
+    @Override
+    public void clear() {
+        super.clear();
+        this.recalculate();
+    }
+
+    @Override
+    public boolean add(final ItemStack itemStack) {
+        throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public ItemStack remove(final int index) {
+        throw new UnsupportedOperationException();
+    }
+
+    private class ItemWatcher implements ChangeListener<ItemStack> {
+        private final ItemStack itemStack;
+        private boolean empty;
+        private boolean full;
+
+        private ItemWatcher(final ItemStack itemStack) {
+            this.itemStack = itemStack;
+            this.update(itemStack);
+            itemStack.watch(this);
+        }
+
+        private void update(final ItemStack itemStack) {
+            this.empty = itemStack.isEmpty();
+            this.full = itemStack.getCount() == this.itemStack.getMaxStackSize();
+        }
+
+        @Override
+        public void changed(final ItemStack itemStack) {
+            SlotCountingItemList.this.updateCounts(this.empty, this.full, this.itemStack);
+            this.update(itemStack);
+        }
+    }
+}
diff --git a/net/minecraft/core/NonNullList.java b/net/minecraft/core/NonNullList.java
