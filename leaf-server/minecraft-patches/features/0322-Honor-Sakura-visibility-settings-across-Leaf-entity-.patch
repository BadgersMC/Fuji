diff --git a/me/samsuik/sakura/player/visibility/MinimalVisibility.java b/me/samsuik/sakura/player/visibility/MinimalVisibility.java
index 0bb9d61d0d377eb1057847233f23209bce6bc5b2..7766ed378c8ce0c5abbb320028d187a27f6bd03e 100644
--- a/me/samsuik/sakura/player/visibility/MinimalVisibility.java
+++ b/me/samsuik/sakura/player/visibility/MinimalVisibility.java
@@ -19,7 +19,7 @@ public final class MinimalVisibility {
     private final ObjectOpenHashSet<BlockPos> explosions = new ObjectOpenHashSet<>();
     private long lastExplosion;
 
-    public boolean filterEntity(final Entity entity) {
+    public synchronized boolean filterEntity(final Entity entity) {
         final BlockPos blockPos = entity.blockPosition();
         final long posAndType = blockPos.asLong() ^ entity.getType().hashCode();
         final Entity visibleEntity = this.minimalEntities.getIfPresent(posAndType);
diff --git a/me/samsuik/sakura/player/visibility/PlayerVisibilitySettings.java b/me/samsuik/sakura/player/visibility/PlayerVisibilitySettings.java
index 5239478c397169f82206fcaefb77f71d2d83596d..4f67c54ec1f4484d9a290604d1fa288108bd802d 100644
--- a/me/samsuik/sakura/player/visibility/PlayerVisibilitySettings.java
+++ b/me/samsuik/sakura/player/visibility/PlayerVisibilitySettings.java
@@ -12,14 +12,14 @@ public final class PlayerVisibilitySettings implements VisibilitySettings {
     private final Reference2ObjectMap<VisibilityType, VisibilityState> visibilityStates = new Reference2ObjectOpenHashMap<>();
 
     @Override
-    public VisibilityState get(final VisibilityType type) {
+    public synchronized VisibilityState get(final VisibilityType type) {
         final VisibilityState state = this.visibilityStates.get(type);
         //noinspection ConstantValue
         return state != null ? state : type.getDefault();
     }
 
     @Override
-    public VisibilityState set(final VisibilityType type, final VisibilityState state) {
+    public synchronized VisibilityState set(final VisibilityType type, final VisibilityState state) {
         if (type.isDefault(state)) {
             this.visibilityStates.remove(type);
         } else {
@@ -29,7 +29,7 @@ public final class PlayerVisibilitySettings implements VisibilitySettings {
     }
 
     @Override
-    public VisibilityState currentState() {
+    public synchronized VisibilityState currentState() {
         final int modifiedCount = this.visibilityStates.size();
         if (modifiedCount == 0) {
             return VisibilityState.ON;
@@ -41,11 +41,11 @@ public final class PlayerVisibilitySettings implements VisibilitySettings {
     }
 
     @Override
-    public boolean playerModified() {
+    public synchronized boolean playerModified() {
         return !this.visibilityStates.isEmpty();
     }
 
-    public void loadData(final ValueInput input) {
+    public synchronized void loadData(final ValueInput input) {
         input.child(VISIBILITY_SETTINGS_TAG).ifPresent(settings -> {
             for (final VisibilityType type : VisibilityTypes.types()) {
                 final String typeKey = type.key();
@@ -55,7 +55,7 @@ public final class PlayerVisibilitySettings implements VisibilitySettings {
         });
     }
 
-    public void saveData(final ValueOutput output) {
+    public synchronized void saveData(final ValueOutput output) {
         final ValueOutput settings = output.child(VISIBILITY_SETTINGS_TAG);
         this.visibilityStates.forEach((type, state) -> settings.putString(type.key(), state.name()));
     }
