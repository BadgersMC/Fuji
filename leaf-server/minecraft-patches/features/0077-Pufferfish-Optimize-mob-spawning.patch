diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index b020ba8a450d57df34f33d2153a2bd10d78ba491..29f66216a573403e90312773d4ca41558f648b4e 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -65,6 +65,77 @@ public final class NaturalSpawner {
     private NaturalSpawner() {
     }
 
+    // Pufferfish - Frontier 26.4: off-thread work operates exclusively on immutable captures.
+    public record CapturedSpawnMob(MobCategory category, BlockPos pos, boolean isMob, double charge) {}
+    public record AsyncSpawnSnapshot(int spawnableChunks, List<CapturedSpawnMob> captured) {}
+    public record AsyncSpawnCounts(
+        int spawnableChunks,
+        Object2IntOpenHashMap<MobCategory> counts,
+        PotentialCalculator potential,
+        it.unimi.dsi.fastutil.longs.Long2ObjectMap<int[]> mobCountsByChunk
+    ) {}
+
+    // Always called on the owning world thread. No live entity, level, chunk or biome reference escapes.
+    public static AsyncSpawnSnapshot captureAsyncSpawnSnapshot(
+        final int spawnableChunks, final ServerLevel level, final NaturalSpawner.ChunkGetter chunkGetter
+    ) {
+        final List<CapturedSpawnMob> captured = new ArrayList<>();
+        final boolean countAll = level.paperConfig().entities.spawning.countAllMobsForSpawning;
+        for (final Entity entity : level.getAllEntities()) {
+            if (entity instanceof Mob mob && (mob.isPersistenceRequired() || mob.requiresCustomPersistence())) {
+                continue;
+            }
+            final MobCategory category = entity.getType().getCategory();
+            if (category == MobCategory.MISC) {
+                continue;
+            }
+            if (!countAll && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
+                && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CHUNK_GEN) {
+                continue;
+            }
+            final BlockPos pos = entity.blockPosition().immutable();
+            chunkGetter.query(ChunkPos.pack(pos), chunk -> {
+                final MobSpawnSettings settings = level.environmentAttributes().getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+                final MobSpawnSettings.MobSpawnCost spawnCost = settings.getMobSpawnCost(entity.getType());
+                captured.add(new CapturedSpawnMob(category, pos, entity instanceof Mob, spawnCost == null ? 0.0 : spawnCost.charge()));
+            });
+        }
+        return new AsyncSpawnSnapshot(spawnableChunks, List.copyOf(captured));
+    }
+
+    // Worker-side: pure reduction of captured immutable values; never touches world/server state.
+    public static AsyncSpawnCounts countCapturedMobs(final AsyncSpawnSnapshot snapshot) {
+        final PotentialCalculator potential = new PotentialCalculator();
+        final Object2IntOpenHashMap<MobCategory> counts = new Object2IntOpenHashMap<>();
+        final it.unimi.dsi.fastutil.longs.Long2ObjectMap<int[]> byChunk = new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+        for (final CapturedSpawnMob mob : snapshot.captured()) {
+            counts.addTo(mob.category(), 1);
+            if (mob.charge() != 0.0) {
+                potential.addCharge(mob.pos(), mob.charge());
+            }
+            if (mob.isMob()) {
+                byChunk.computeIfAbsent(ChunkPos.pack(mob.pos()), key -> new int[MobCategory.values().length])[mob.category().ordinal()]++;
+            }
+        }
+        return new AsyncSpawnCounts(snapshot.spawnableChunks(), counts, potential, byChunk);
+    }
+
+    // Owning world thread: applies local mob-cap bookkeeping and publishes the completed spawn state.
+    public static SpawnState restoreAsyncSpawnState(final AsyncSpawnCounts result, final LocalMobCapCalculator localCaps) {
+        for (final it.unimi.dsi.fastutil.longs.Long2ObjectMap.Entry<int[]> entry : result.mobCountsByChunk().long2ObjectEntrySet()) {
+            final long key = entry.getLongKey();
+            final ChunkPos pos = new ChunkPos(ChunkPos.getX(key), ChunkPos.getZ(key));
+            final int[] counts = entry.getValue();
+            for (final MobCategory category : MobCategory.values()) {
+                final int count = counts[category.ordinal()];
+                if (count != 0) {
+                    localCaps.addMobs(pos, category, count);
+                }
+            }
+        }
+        return new SpawnState(result.spawnableChunks(), result.counts(), result.potential(), localCaps);
+    }
+
     public static NaturalSpawner.SpawnState createState(
         final int spawnableChunkCount, final ServerLevel level, final NaturalSpawner.ChunkGetter chunkGetter, final LocalMobCapCalculator localMobCapCalculator
     ) {
