From a01d6f407b2b4e568073684c5df0bc049d765c09 Mon Sep 17 00:00:00 2001
From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:24:46 -0500
Subject: [PATCH] Fix MC-17876

Frontier 26.4: preserve valid stored entity health before equipment attribute modifiers are initialized; retain default setter caps and finite-value checks for runtime healing. Original MC bugfix credit to HaHaWTH and Bjarne Koll.

Co-authored-by: Bjarne Koll <git@lynxplay.dev>
---
 net/minecraft/world/entity/LivingEntity.java | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 9f8e5bb..151e839 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -916,7 +916,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             this.getAttribute(Attributes.MAX_HEALTH).setBaseValue(maxHealth);
         });
         // CraftBukkit end
-        this.setHealth(input.getFloatOr("Health", this.getMaxHealth()));
+        this.setHealth(input.getFloatOr("Health", this.getMaxHealth()), true); // Leaf - MC-17876: retain stored health before equipment modifiers load
         this.hurtTime = input.getShortOr("HurtTime", (short)0);
         this.deathTime = input.getShortOr("DeathTime", (short)0);
         this.setSharedFlag(Entity.FLAG_FALL_FLYING, input.getBooleanOr("FallFlying", false));
@@ -1447,7 +1447,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     // Paper start - Check for NaN
-    public void setHealth(float health) {
+    public void setHealth(final float health) {
+        this.setHealth(health, false);
+    }
+
+    private void setHealth(float health, final boolean bypassCap) {
         if (Float.isNaN(health)) { health = getMaxHealth(); if (this.valid) {
             System.err.println("[NAN-HEALTH] " + getScoreboardName() + " had NaN health set");
         } } // Paper end - Check for NaN
@@ -1457,7 +1461,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             // Squeeze
             if (health < 0.0F) {
                 player.setRealHealth(0.0);
-            } else if (health > player.getMaxHealth()) {
+            } else if (!bypassCap && health > player.getMaxHealth()) {
                 player.setRealHealth(player.getMaxHealth());
             } else {
                 player.setRealHealth(health);
@@ -1468,7 +1472,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             return;
         }
         // CraftBukkit end
-        this.entityData.set(DATA_HEALTH_ID, Math.clamp(health, 0.0F, this.getMaxHealth()));
+        this.entityData.set(DATA_HEALTH_ID, bypassCap ? (Float.isFinite(health) ? Math.max(0.0F, health) : 0.0F) : Math.clamp(health, 0.0F, this.getMaxHealth()));
     }
 
     public boolean isDeadOrDying() {
-- 
