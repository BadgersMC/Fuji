26.4 Snapshot 8 adaptation: gate the current DevUtil far-chunk warning without changing the out-of-range block-write rejection.

diff --git a/net/minecraft/server/level/WorldGenRegion.java b/net/minecraft/server/level/WorldGenRegion.java
index ef38bc2338da1cfc90a6a5649100c8f13d04ce32..0e672ac3a2dcdc2fa5adf3d5fc4c6f8079fd2338 100644
--- a/net/minecraft/server/level/WorldGenRegion.java
+++ b/net/minecraft/server/level/WorldGenRegion.java
@@ -313,7 +313,7 @@ public class WorldGenRegion implements WorldGenLevel {
             int chunkX = SectionPos.blockToSectionCoord(pos.getX());
             int chunkZ = SectionPos.blockToSectionCoord(pos.getZ());
             // Paper start - Buffer OOB setBlock calls
-            if (!hasSetFarWarned) {
+            if (org.galemc.gale.configuration.GaleGlobalConfiguration.get().logToConsole.setBlockInFarChunk && !hasSetFarWarned) { // Gale / Purpur - configurable far-chunk warnings
             DevUtil.logAndPauseIfInIde(
                 "Detected setBlock in a far chunk ["
                     + chunkX
